---
import { Image } from 'astro:assets';
import { profile } from '~/data/profile';
import defaultAvatar from '~/assets/markus.jpg';

// Stagger each word across all claim lines, but accent the closing
// word of every line for a bolder, poster-like rhythm.
let wordIndex = 0;
const claimLines = profile.claim.map((line) => {
  const words = line.split(' ');
  return words.map((word, wi) => ({
    word,
    accent: wi === words.length - 1,
    last: wi === words.length - 1,
    delay: 300 + wordIndex++ * 90,
  }));
});
---

<header class="hero">
   <div class="hero__top" data-reveal>
     <div class="hero__avatar">
      {profile.avatar ? (
        <img
          src={profile.avatar}
          alt={`Portrait von ${profile.name}`}
          width="110"
          height="110"
          loading="eager"
          fetchpriority="high"
          class="hero__avatar-img"
        />
      ) : (
        <Image
          src={defaultAvatar}
          alt={`Portrait von ${profile.name}`}
          widths={[92, 184, 276]}
          sizes="(min-width: 720px) 110px, 92px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          class="hero__avatar-img"
        />
      )}
     </div>
   <div class="hero__meta">
      <span class="hero__name">{profile.name}</span>
      <span class="hero__handle">@{profile.handle}</span>
      <span class="hero__location">
        <span class="hero__pulse"></span>
        {profile.location}
      </span>
   </div>
</div>

<h1 class="hero__claim" aria-label={profile.claim.join(' ')}>
  {claimLines.map((words) => (
    <span class="hero__claim-line">
      {words.map(({ word, accent, last, delay }) => (
        <span
          class={`hero__claim-word${accent ? ' hero__claim-word--accent' : ''}`}
          style={`--delay: ${delay}ms`}
        >{word}{!last ? ' ' : ''}</span>
      ))}
    </span>
  ))}
</h1>

<p class="hero__tagline" data-reveal style="--delay: 700ms">
  {profile.tagline}
</p>

<div class="breath" data-reveal style="--delay: 900ms" aria-hidden="true">
  <span class="breath__orb"><span class="breath__core"></span></span>
  <span class="breath__cue">
    <span class="breath__word breath__word--in">einatmen</span>
    <span class="breath__word breath__word--out">ausatmen</span>
  </span>
</div>
</header>
